# The public address users open in their browser is configured in GitHub OAuth.
# The compose port stays loopback-only and is normally exposed by a TLS proxy.
JUPYTERHUB_BIND_IP=127.0.0.1
JUPYTERHUB_PORT=8000
DOCKER_NETWORK_NAME=scarlet-jupyterhub

# Use an immutable image digest in production after it has been built and pushed.
SCARLET_NOTEBOOK_IMAGE=scarlet-notebook:0.2.4

# Comma-separated GitHub logins. Every administrator must also be allowed.
JUPYTERHUB_ADMIN_USERS=replace-with-admin-login
JUPYTERHUB_ALLOWED_USERS=replace-with-admin-login,replace-with-collaborator-login

# Production authentication. Register this callback URL in the GitHub OAuth app.
JUPYTERHUB_AUTH_MODE=github
JUPYTERHUB_GITHUB_CLIENT_ID=
JUPYTERHUB_GITHUB_CLIENT_SECRET=
JUPYTERHUB_OAUTH_CALLBACK_URL=https://hub.example.org/hub/oauth_callback

# Generate with: openssl rand -hex 32
JUPYTERHUB_COOKIE_SECRET=

# Optional. This host directory is mounted read-only at /home/jovyan/shared-data.
SCARLET_SHARED_DATA_DIR=

# Local demonstration only: set JUPYTERHUB_AUTH_MODE=dummy and a non-empty password.
JUPYTERHUB_DUMMY_PASSWORD=
